# Stoora web: environment variables.
# Copy this file to  .env.local  and fill in the values. .env.local is git-ignored: never commit real keys.
# Leave the two NEXT_PUBLIC_SUPABASE_* lines empty and the app runs in DEMO MODE (sample data, no sign-in needed).
# After changing a NEXT_PUBLIC_* value, restart `npm run dev` (or rebuild) so the browser code picks it up.

# ---------------------------------------------------------------------------------------------------------
# 1. Supabase project            Dashboard > your project > Project Settings > API
# ---------------------------------------------------------------------------------------------------------
# The project URL, like https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" / "publishable" key. It is safe in the browser: row level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" / "secret" key bypasses all security rules. Server only. NOT used by the app today:
# keep it empty unless you add server jobs (payment webhooks, scripts). Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# The public address of this site, no trailing slash. Used to build the Google return address.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ---------------------------------------------------------------------------------------------------------
# 2. Sign in with Google          Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web)
# ---------------------------------------------------------------------------------------------------------
# These are typed into Supabase (Authentication > Providers > Google), NOT read by the Next.js app.
# They are listed here so the whole team knows what to collect. For local Supabase (supabase start) put them in your shell.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# In Google Cloud, "Authorized redirect URI" must be:  https://<your-project>.supabase.co/auth/v1/callback

# ---------------------------------------------------------------------------------------------------------
# 3. WhatsApp / SMS codes         Twilio console (needs a WhatsApp sender or a Messaging Service)
# ---------------------------------------------------------------------------------------------------------
# Typed into Supabase (Authentication > Providers > Phone > Twilio), not read by the Next.js app.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGE_SERVICE_SID=

# ---------------------------------------------------------------------------------------------------------
# 4. Only for the Supabase CLI (supabase link / supabase db push)
# ---------------------------------------------------------------------------------------------------------
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=
