# ---------------------------------------------------------------------------
# Stoora settings. Copy this file to ".env" and fill in what you need.
# Every line is optional: anything you leave empty simply stays switched off,
# and Settings > Apps in the dashboard shows what is on.
# NEVER commit ".env" or share it. It holds your secret keys.
# ---------------------------------------------------------------------------

# --- The server --------------------------------------------------------------
NODE_ENV=development
# Set NODE_ENV=production on the live server. In production, emails are never printed and addresses are never auto-confirmed.
PORT=3000
# Where the database file lives. Default: data/stoora.db
# DB_PATH=./data/stoora.db
# The public address of the site, no trailing slash. Used in emails and in the
# webhook addresses shown in the dashboard.   Example: https://stoora.in
# APP_URL=
# Set to 1 once the site is served over https (marks the login cookie Secure).
# COOKIE_SECURE=1
# Set to 1 if the server sits behind a reverse proxy (nginx, a cloud load balancer).
# TRUST_PROXY=1

# --- Razorpay: online payments (https://dashboard.razorpay.com) --------------
# Dashboard > Account & Settings > API keys. Start with TEST keys (rzp_test_...).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Account & Settings > Webhooks: add <APP_URL>/api/webhooks/razorpay,
# choose the events payment.captured, order.paid, payment.failed, refund.processed,
# and type a secret of your own. Put the same secret here.
RAZORPAY_WEBHOOK_SECRET=
# Set to 1 only if Razorpay Route is enabled on your account. Then online payments
# go straight to each seller's linked account (the seller adds it in Settings > Payments).
# RAZORPAY_ROUTE=1

# --- Email: confirmation links, password reset, "new order" alerts -----------
# Pick one provider.
# Option A: Resend (https://resend.com): create an API key and verify your domain.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# Option B: SMTP over TLS (Gmail app password, Zoho, your hosting provider ...)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# The sender shown on emails (a domain you own).   Example: Stoora <hello@stoora.in>
EMAIL_FROM=

# --- Writing helpers: "Write it for me" and reading a chat into an order draft (https://console.anthropic.com)
# Without a key they use a simple template instead.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5

# --- Sign in with Google (https://console.cloud.google.com) ------------------
# APIs & Services > Credentials > Create OAuth client ID > Web application.
# Add your site address under "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=

# ---- Premium storefront templates (paid by sellers; separate from buyers' order payments) ----
# Price in whole rupees. Leave empty and no price is shown and nothing can be bought.
PREMIUM_PRICE_INR=
# Set to 1 to allow purchases (also needs RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET).
PREMIUM_PURCHASES_ENABLED=0
# Optional terms shown in the purchase dialog.
PREMIUM_TERMS=
# Optional comma-separated account emails that get every premium template free (for you and testers).
PREMIUM_GRANT_EMAILS=

# ---- Who receives a buyer's online payment ----
# Razorpay Route pays each seller into their own linked account. Switch it on only when Razorpay has enabled
# Route on your account; each seller then links an activated account in Settings > Payments.
# RAZORPAY_ROUTE=1
# Without Route a payment lands in YOUR Razorpay account, not the seller's. Sellers can only take online
# payments in that case if you set this to 1, which means you have agreed to collect for sellers and pay
# them out yourself (a legal and accounting decision, not a technical one). Leave it off otherwise.
# RAZORPAY_COLLECT_TO_PLATFORM=1
# Minutes an online-payment order may wait for payment. After that it is cancelled and its stock is released.
# ORDER_PAYMENT_HOLD_MINUTES=30
